{
  "name": "@sayanmohsin/nice-code",
  "version": "0.3.2",
  "description": "Source-backed engineering guardrails for reliable software development",
  "repository": {
    "type": "git",
    "url": "https://github.com/sayanmohsin/nice-code.git"
  },
  "homepage": "https://github.com/sayanmohsin/nice-code#readme",
  "bugs": {
    "url": "https://github.com/sayanmohsin/nice-code/issues"
  },
  "license": "MIT",
  "keywords": [
    "engineering",
    "code-review",
    "cli",
    "static-analysis",
    "guardrails"
  ],
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "scripts/nice-code.mjs",
    "scripts/skills.mjs",
    "scripts/project.mjs",
    "scripts/knowledge.mjs",
    "scripts/rules.mjs",
    "knowledge/",
    "patterns/",
    "sources/",
    "skills/",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "nice-code": "scripts/nice-code.mjs"
  },
  "scripts": {
    "check": "node scripts/nice-code.mjs --all --project .",
    "metrics": "bun scripts/metrics.mts",
    "init": "bun scripts/init.mts",
    "skills": "node scripts/skills.mjs",
    "skills:check": "node scripts/skills.mjs check",
    "knowledge:check": "node scripts/knowledge.mjs check",
    "knowledge:compile": "node scripts/knowledge.mjs compile",
    "knowledge:outdated": "node scripts/knowledge.mjs outdated",
    "knowledge:list": "node scripts/knowledge.mjs list",
    "rules": "node scripts/rules.mjs",
    "check:contributor": "cargo fmt --manifest-path engine/Cargo.toml -- --check && npm run knowledge:check && npm run skills:check && npm run check:docs && npm run check:version && bun scripts/test-engine.ts && npm test && npm run pack:check && git diff --check",
    "hooks:install": "node scripts/pre-commit.mjs --install",
    "precommit": "node scripts/pre-commit.mjs",
    "test": "cargo test --manifest-path engine/Cargo.toml && node --test scripts/project.test.mjs scripts/knowledge.test.mjs scripts/package.test.mjs scripts/rules.test.mjs",
    "test:bun": "bun scripts/test-engine.ts",
    "check:docs": "bun scripts/check-docs.mts",
    "check:version": "bun scripts/check-version.mts",
    "pack:check": "npm pack --dry-run",
    "release": "bun scripts/release.mts",
    "benchmark": "bun scripts/benchmark.ts",
    "engine:build": "cargo build --release --manifest-path engine/Cargo.toml",
    "engine:test": "cargo test --manifest-path engine/Cargo.toml",
    "engine:check": "node scripts/nice-code.mjs --project . --changed",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "docs:format:check": "pnpm --dir docs format:check"
  }
}
